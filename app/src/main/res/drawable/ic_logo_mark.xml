<!-- Wallscout logo mark for the header lockup: the app icon as a plain round image
     (sunset circle + magnifier), so it looks the same on every launcher shape. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="36dp"
    android:height="36dp"
    android:viewportWidth="72"
    android:viewportHeight="72">
    <!-- Sunset circle -->
    <path android:pathData="M0,36a36,36 0,1 0,72 0a36,36 0,1 0,-72 0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="72"
                android:endY="72"
                android:startColor="#FFFFB547"
                android:endColor="#FFFF4F7B" />
        </aapt:attr>
    </path>
    <!-- Scene inside the lens -->
    <group>
        <clip-path android:pathData="M12,29.6a18.6,18.6 0,1 0,37.2 0a18.6,18.6 0,1 0,-37.2 0z" />
        <path android:pathData="M10,9h42v42h-42z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="31"
                    android:startY="9"
                    android:endX="31"
                    android:endY="51"
                    android:startColor="#FF7DBDEB"
                    android:endColor="#FFFFDDB8" />
            </aapt:attr>
        </path>
        <path
            android:fillColor="#FFFFB547"
            android:pathData="M34.7,20.5a4.3,4.3 0,1 0,8.6 0a4.3,4.3 0,1 0,-8.6 0z" />
        <path
            android:fillColor="#FF3C3489"
            android:pathData="M11,41.5l10.2,-10.8 7.8,7.8 6,-5.4 15.6,12.6V49H11z" />
        <path
            android:fillColor="#FF1E1A4F"
            android:pathData="M11,46.8l12,-6.6 9.6,4.8 7.2,-3.6 11.2,5.8V49H11z" />
    </group>
    <!-- Glint, ring and handle -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:pathData="M18.4,21.2a14.4,14.4 0,0 1,7.2 -5.4" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5.3"
        android:pathData="M12,29.6a18.6,18.6 0,1 0,37.2 0a18.6,18.6 0,1 0,-37.2 0z" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7.8"
        android:strokeLineCap="round"
        android:pathData="M45.3,44.3L54.7,53.7" />
</vector>
