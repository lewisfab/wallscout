<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        style="@style/ContentColumn"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <!-- Title with the tagline beside it, sharing a baseline. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <!-- Logo mark; size, gap and baseline are matched to the title text in Logotype.kt. -->
            <ImageView
                android:id="@+id/logoMark"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_logo_mark" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="?attr/textAppearanceHeadlineMedium" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"
                android:gravity="end"
                android:text="@string/tagline"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

        <!-- Current wallpaper; each image has its own trash and refresh buttons.
             (The page above takes focus first so the dropdowns below don't grab it and
             make the page jump down when the preview resizes.) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/SettingsCard"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include layout="@layout/previews" />

                <!-- Only until the first wallpaper is set; after that, the previews' refresh buttons do this. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/firstWallpaper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Get my first wallpaper"
                    android:visibility="gone" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:trackCornerRadius="2dp" />

                <TextView
                    android:id="@+id/caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_horizontal"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?android:attr/textColorSecondary"
                    android:visibility="gone" />

                <!-- Next scheduled change, and pause/resume. -->
                <LinearLayout
                    android:id="@+id/pauseRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/pauseText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?android:attr/textColorSecondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pauseButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pause" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Pages: adjustments and history. -->
        <com.google.android.material.card.MaterialCardView
            style="@style/SettingsCard"
            app:contentPaddingBottom="4dp"
            app:contentPaddingTop="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/adjustRow"
                    style="@style/NavRow">
                    <ImageView style="@style/NavIcon" android:src="@drawable/ic_tune" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/RowTitle" android:text="Image Adjustments" />
                        <TextView android:id="@+id/adjustSummary" style="@style/Label" />
                    </LinearLayout>
                    <ImageView style="@style/NavIcon" android:layout_marginEnd="0dp" android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider style="@style/Divider" />

                <LinearLayout
                    android:id="@+id/historyRow"
                    style="@style/NavRow">
                    <ImageView style="@style/NavIcon" android:src="@drawable/ic_history" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/RowTitle" android:text="History" />
                        <TextView android:id="@+id/historySummary" style="@style/Label" />
                    </LinearLayout>
                    <ImageView style="@style/NavIcon" android:layout_marginEnd="0dp" android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider style="@style/Divider" />

                <LinearLayout
                    android:id="@+id/favoritesRow"
                    style="@style/NavRow">
                    <ImageView style="@style/NavIcon" android:src="@drawable/ic_star_row" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/RowTitle" android:text="Favorites" />
                        <TextView android:id="@+id/favoritesSummary" style="@style/Label" />
                    </LinearLayout>
                    <ImageView style="@style/NavIcon" android:layout_marginEnd="0dp" android:src="@drawable/ic_chevron_right" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Where images come from. -->
        <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/CardTitle" android:text="Image source" />
                <TextView
                    android:id="@+id/credit"
                    style="@style/Label"
                    android:layout_marginBottom="4dp"
                    android:text="Images from wallhaven.cc, safe-for-work only (NSFW is always excluded). Tap a preview to see its page, uploader and original source." />

                <TextView style="@style/Label" android:layout_marginTop="4dp" android:text="Search terms (one is picked each change)" />
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/searchChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="2dp" />


                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Dropdown"
                    android:hint="Pick images from">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/sort"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    style="@style/NavRow">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/RowTitle" android:text="Include favorites" />
                        <TextView style="@style/Label" android:text="Favorites count as one more search term" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/includeFavorites"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <TextView style="@style/Label" android:layout_marginTop="12dp" android:text="Excluded terms (never show)" />
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/excludeChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="2dp" />

                <LinearLayout
                    style="@style/NavRow">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/RowTitle" android:text="Photos only" />
                        <TextView style="@style/Label" android:text="Skip anime, digital art and renders" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/photosOnly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- When it changes. -->
        <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/CardTitle" android:text="Schedule" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/enabled"
                    style="@style/SwitchRow"
                    android:text="Change automatically" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/intervalBox"
                    style="@style/Dropdown"
                    android:hint="How often">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/interval"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:id="@+id/timeRow"
                    style="@style/NavRow"
                    android:minHeight="44dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp">
                    <TextView
                        android:id="@+id/timeLabel"
                        style="@style/RowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="At about" />
                    <TextView
                        android:id="@+id/timeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/wifiOnly"
                    style="@style/SwitchRow"
                    android:text="Only update on Wi-Fi" />

                <LinearLayout
                    style="@style/NavRow">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/RowTitle" android:text="Alert me if changes fail" />
                        <TextView style="@style/Label" android:text="A notification if a scheduled change still fails after retrying" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/failureAlerts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/allowBackground"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Allow background updates"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/allowBackgroundHint"
                    style="@style/Label"
                    android:layout_gravity="center_horizontal"
                    android:text="Optional: keeps changes on time"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- How it's shown. -->
        <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/CardTitle" android:text="Display" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Dropdown"
                    android:hint="Apply to">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/target"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    style="@style/NavRow"
                    android:layout_marginTop="4dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/RowTitle" android:text="Prefer portrait images" />
                        <TextView style="@style/Label" android:text="Less cropping on your phone's tall screen" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/portrait"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <LinearLayout
                    style="@style/NavRow"
                    android:layout_marginTop="4dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/RowTitle" android:text="Sharp images only" />
                        <TextView style="@style/Label" android:text="Skip images smaller than your screen, which can look soft" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/sharpOnly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/parallax"
                    style="@style/SwitchRow"
                    android:text="Parallax on home screen" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Extras: Quick Settings tile and backup. -->
        <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/CardTitle" android:text="More" />

                <LinearLayout
                    android:id="@+id/addTile"
                    style="@style/NavRow">
                    <ImageView style="@style/NavIcon" android:src="@drawable/ic_tile_refresh" android:tint="?android:attr/textColorPrimary" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/RowTitle" android:text="Add Quick Settings tile" />
                        <TextView style="@style/Label" android:text="A &quot;New wallpaper&quot; button in your pull-down settings" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider style="@style/Divider" />

                <LinearLayout
                    android:id="@+id/exportRow"
                    style="@style/NavRow">
                    <ImageView style="@style/NavIcon" android:src="@drawable/ic_export" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/RowTitle" android:text="Export settings" />
                        <TextView style="@style/Label" android:text="Save settings, favorites and blocked images to a file" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider style="@style/Divider" />

                <LinearLayout
                    android:id="@+id/importRow"
                    style="@style/NavRow">
                    <ImageView style="@style/NavIcon" android:src="@drawable/ic_import" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/RowTitle" android:text="Import settings" />
                        <TextView style="@style/Label" android:text="Restore from a Wallscout backup file" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
